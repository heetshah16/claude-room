{
  "name": "claude-room-orchestrator",
  "displayName": "Claude Room Orchestrator",
  "description": "A group chat for your team and your Claude Code sessions: invite people with a link, @mention Claude, and hand routine work to free-model workers.",
  "version": "0.0.5",
  "publisher": "claude-room",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/heetshah16/claude-room.git"
  },
  "engines": {
    "vscode": "^1.75.0",
    "node": ">=22"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "ai",
    "agents",
    "multiplayer",
    "collaboration",
    "chat",
    "opencode"
  ],
  "activationEvents": [],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeRoom.openChat",
        "title": "Claude Room: Open Orchestrator Chat"
      },
      {
        "command": "claudeRoom.restart",
        "title": "Claude Room: Restart Services"
      },
      {
        "command": "claudeRoom.installTools",
        "title": "Claude Room: Check Required Tools"
      }
    ],
    "configuration": {
      "title": "Claude Room",
      "properties": {
        "claudeRoom.enableChat": {
          "type": "boolean",
          "default": false,
          "description": "Show the orchestrator chat window. Off by default: Claude Code's own UI is the chat, and this extension's job is the Room and Workers views. The chat still works if you turn this on."
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "claudeRoom.openChat",
          "when": "config.claudeRoom.enableChat"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claudeRoom",
          "title": "Claude Room",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "claudeRoom": [
        {
          "id": "claudeRoom.room",
          "name": "Room",
          "type": "webview"
        },
        {
          "id": "claudeRoom.workers",
          "name": "Workers",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test",
    "vscode:prepublish": "node ../scripts/bundle-room.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "devDependencies": {
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0"
  }
}
